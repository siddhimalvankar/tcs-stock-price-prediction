      "source": [
        "# Moving averages\n",
        "stock['MA5'] = stock['Close'].rolling(5).mean()\n",
        "stock['MA20'] = stock['Close'].rolling(20).mean()\n",
        "\n",
        "# Daily return\n",
        "stock['Return'] = stock['Close'].pct_change()\n",
        "\n",
        "# Volatility (risk indicator)\n",
        "stock['Volatility'] = stock['Return'].rolling(5).std()\n",
        "\n",
        "# Daily range\n",
        "stock['High_Low'] = stock['High'] - stock['Low']\n",
        "\n",
        "# Momentum indicator\n",
        "stock['Momentum'] = stock['Close'] - stock['Close'].shift(5)\n",
        "\n",
        "stock['Target'] = stock['Close'].shift(-1)\n",
        "stock = stock.dropna()\n",
        "print(\"Rows after cleaning:\", len(stock))"
      ],
