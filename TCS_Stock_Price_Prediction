        "!pip install yfinance\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import yfinance as yf\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "from sklearn.metrics import mean_squared_error, r2_score\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "stock = yf.download(\"TCS.NS\", period=\"10y\")\n",
        "\n",
        "print(\"Rows after download:\", len(stock))\n",
        "\n",
        "# Moving averages\n",
        "stock['MA5'] = stock['Close'].rolling(5).mean()\n",
        "stock['MA20'] = stock['Close'].rolling(20).mean()\n",
        "\n",
        "# Daily return\n",
        "stock['Return'] = stock['Close'].pct_change()\n",
        "\n",
        "# Volatility (risk indicator)\n",
        "stock['Volatility'] = stock['Return'].rolling(5).std()\n",
        "\n",
        "# Daily range\n",
        "stock['High_Low'] = stock['High'] - stock['Low']\n",
        "\n",
        "# Momentum indicator\n",
        "stock['Momentum'] = stock['Close'] - stock['Close'].shift(5)\n",
        "\n",
        "stock['Target'] = stock['Close'].shift(-1)\n",
        "stock = stock.dropna()\n",
        "print(\"Rows after cleaning:\", len(stock))\n",
        "\n",
        "features = [\n",
        "    'Open','High','Low','Volume',\n",
        "    'MA5','MA20','Return','Volatility',\n",
        "    'High_Low','Momentum'\n",
        "]\n",
        "\n",
        "X = stock[features]\n",
        "y = stock['Target']\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y,\n",
        "    test_size=0.2,\n",
        "    shuffle=False\n",
        ")\n",
        "\n",
        "model = RandomForestRegressor(\n",
        "    n_estimators=300,\n",
        "    max_depth=20,\n",
        "    random_state=42,\n",
        ")\n",
        "\n",
        "model.fit(X_train, y_train)\n",
        "pred = model.predict(X_test)\n",
        "results = pd.DataFrame({\n",
        "    'Actual Price': y_test.values,\n",
        "    'Predicted Price': pred\n",
        "})\n",
        "print(\"\\nFirst 10 predictions:\")\n",
        "print(results.head(10))\n",
        "\n",
        "last_features = X.iloc[-1:]\n",
        "next_day_pred = model.predict(last_features)[0]\n",
        "print(\"\\nPredicted Next Day Closing Price:\", round(next_day_pred, 2))\n",
